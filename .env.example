# 33rpm configuration. Copy to `.env` and edit. Never commit your real `.env`.
# Every variable is also documented in the README.

# --- Required ----------------------------------------------------------------

# Public URL people use to reach 33rpm (no trailing slash). Used for OIDC
# redirects and cookie security: https:// here => Secure cookies.
APP_URL=http://localhost:3000

# Random secret, at least 32 chars. Signs sessions. Generate: openssl rand -base64 32
AUTH_SECRET=

# --- Storage -----------------------------------------------------------------

# Directory for the database, cached images and backups. In Docker, mount a volume here.
# Default: /data in production, ./data in development.
# DATA_DIR=/data

# Database connection. SQLite only for now: file:<path>. (PostgreSQL arrives in Phase 0.5.)
# Default: file:${DATA_DIR}/33rpm.db
# DATABASE_URL=file:/data/33rpm.db

# Key for encrypting secrets stored in the database (e.g. your Discogs token).
# At least 32 chars. If unset, a key is derived from AUTH_SECRET.
# Changing whichever one is in use means stored tokens must be re-entered.
# ENCRYPTION_KEY=

# --- Docker only -------------------------------------------------------------

# The container drops privileges to this uid/gid and makes /data owned by it.
# Set them to the owner of your bind-mounted data directory (`id -u`, `id -g`).
# PUID=1000
# PGID=1000

# --- Sign-in -----------------------------------------------------------------

# Allow email/password sign-in for the local admin. Set to false once SSO works
# (requires OIDC to be configured).
# AUTH_LOCAL_LOGIN=true

# Generic OpenID Connect (Authentik, Authelia, Keycloak, Pocket ID, Zitadel, ...).
# Register this redirect URI with your IdP:  ${APP_URL}/api/auth/callback/oidc
# All three of ISSUER/CLIENT_ID/CLIENT_SECRET must be set to enable SSO.
# OIDC_ISSUER=https://auth.example.com/application/o/33rpm/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_PROVIDER_NAME=SSO
# OIDC_SCOPES=openid profile email

# Create a new 33rpm account the first time an unknown IdP user signs in.
# Default false: SSO only signs in existing accounts.
# OIDC_AUTO_SIGNUP=false

# Optional allowlist for SSO sign-in, linking and sign-up. Comma-separated
# addresses and/or @domains. Empty = whoever your IdP lets through.
# OIDC_ALLOWED_EMAILS=me@example.com,@family.example

# --- Reverse proxy -----------------------------------------------------------

# IPs/CIDRs of your reverse proxies. Lets 33rpm find the real client IP in
# X-Forwarded-For chains (used for sign-in rate limiting).
# TRUSTED_PROXIES=172.18.0.0/16

# Header(s) carrying the client IP, in order. Default: x-forwarded-for.
# Cloudflare Tunnel: cf-connecting-ip. Nginx `proxy_set_header X-Real-IP`: x-real-ip.
# IP_ADDRESS_HEADERS=x-forwarded-for

# --- Metadata ----------------------------------------------------------------

# Default Discogs personal access token. A token saved in Settings overrides it.
# DISCOGS_TOKEN=
