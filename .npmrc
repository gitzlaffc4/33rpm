# Pin exact versions on `npm install <pkg>`.
save-exact=true

# Never run dependency install scripts (supply-chain hygiene).
#
# How better-sqlite3 gets its native binding WITHOUT install scripts:
#   better-sqlite3 13 ships prebuilt binaries inside the npm tarball itself
#   (prebuilds/{linux,linuxmusl,darwin,win32}-{x64,arm64}.node). At runtime,
#   lib/binding.js uses a node-gyp build/ output if one exists, otherwise it loads
#   prebuilds/<platform>-<arch>.node. Nothing is downloaded or compiled, so no
#   explicit rebuild/prebuild step exists or is needed:
#   - local dev / CI:  `npm ci` unpacks the tarball; the matching .node loads.
#                      CI also asserts this in an explicit "verify" step.
#   - Docker (amd64 and arm64, each built natively): same `npm ci`; next.config.ts
#     forces both linux-x64 and linux-arm64 binaries into the standalone output,
#     and the Dockerfile build stage fails unless the binding loads.
#   Unsupported targets (e.g. 32-bit ARM) would need `npm rebuild better-sqlite3`
#   with a C++ toolchain and Python; we don't build images for them.
#
# Why this is also required, not just hygiene: npm 11 (bundled with Node 24) runs
# an implicit `node-gyp rebuild` for any package containing binding.gyp, ignoring
# better-sqlite3's "gypfile": false. That needs Python and fails in slim images.
# esbuild and sharp get their binaries from optional dependencies, not scripts.
ignore-scripts=true
