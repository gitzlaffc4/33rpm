# Pin exact versions on `npm install <pkg>`.
save-exact=true
# Don't run dependency install scripts (supply-chain hygiene). Nothing here needs
# them: better-sqlite3 ships prebuilt binaries for every platform we target and
# esbuild/sharp resolve theirs via optional dependencies. This also stops npm 11
# from trying to compile better-sqlite3 with node-gyp.
ignore-scripts=true
