{
  "name": "33rpm",
  "version": "0.1.0-alpha.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate --config drizzle.sqlite.config.ts && drizzle-kit generate --config drizzle.pg.config.ts",
    "db:studio": "drizzle-kit studio --config drizzle.sqlite.config.ts",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "build:cli": "esbuild src/cli.ts --bundle --platform=node --target=node26 --format=cjs --outfile=dist/cli.js --external:better-sqlite3 --external:pg --external:pg-native --log-level=warning",
    "db:seed": "esbuild scripts/seed.ts --bundle --platform=node --target=node26 --format=cjs --outfile=dist/seed.js --external:better-sqlite3 --external:pg --external:pg-native --external:sharp --alias:server-only=./tests/stubs/server-only.ts --log-level=warning && node --env-file-if-exists=.env dist/seed.js",
    "bench": "npm run build:bench && node dist/bench.js",
    "build:bench": "esbuild scripts/bench.ts --bundle --platform=node --target=node26 --format=cjs --outfile=dist/bench.js --external:better-sqlite3 --external:pg --external:pg-native --external:sharp --alias:server-only=./tests/stubs/server-only.ts --log-level=warning"
  },
  "dependencies": {
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-slot": "1.5.0",
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "better-auth": "1.7.25",
    "better-sqlite3": "13.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.74.0",
    "next": "16.4.6",
    "next-themes": "0.4.6",
    "p-queue": "10.0.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "4.3.5",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=26"
  }
}
